# Copy to .env and fill in. Never commit .env.
# Put each value in single quotes, e.g. ADMIN_PASSWORD='my$ecret',
# otherwise Docker treats a $ in a password as a variable.

# Long random string used to sign login cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=''

# First-run passwords. Used only to create the two accounts the first
# time the app starts. Change them later in Settings.
MSIMIC_PASSWORD=''
ADMIN_PASSWORD=''

# Optional read-only guest account (username: guest) for people who want to
# see what the app looks like. Guests can browse everything but nothing they
# do is saved, and they cannot open Settings, My progress or Admin.
# Set a simple password (4+ characters) to turn it on; leave it empty to turn it off.
GUEST_PASSWORD=''

# Where the SQLite database is stored (Docker mounts a volume here).
DATA_DIR=./data

# Your domain, used by Caddy for HTTPS (docker-compose only).
DOMAIN=learn.example.com
